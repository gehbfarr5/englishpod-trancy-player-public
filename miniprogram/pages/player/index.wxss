page {
  height: 100%;
}

/* 播放器全屏根容器 */
.player-root {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: var(--bgColor);
}

/* 顶部栏（自定义导航） */
.pl__topbar {
  flex: none;
  background-color: var(--bgColor);
  box-sizing: border-box;
  z-index: 20;
}

.pl__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  gap: var(--ep-space-sm);
}

.pl__back {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  box-sizing: border-box;
  transition: opacity var(--ep-dur-fast) var(--ep-ease-smooth-out);
}

.pl__back--hover {
  opacity: 0.5;
}

.pl__back-chevron {
  width: 10px;
  height: 10px;
  border-left: 2.2px solid var(--ep-text-primary);
  border-bottom: 2.2px solid var(--ep-text-primary);
  transform: rotate(45deg);
  margin-left: 4px;
  box-sizing: border-box;
}

.pl__bar-title-wrap {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.pl__bar-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ep-text-primary);
  letter-spacing: -0.3px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  width: 100%;
  text-align: left;
}

/* 正文容器 */
.pl__stage {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  overflow: hidden;
  margin: 0;
  padding: 0;
  background-color: var(--bgColor);
}

.pl__layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: 0;
  padding: 0;
  line-height: normal;
  transition: opacity var(--ep-dur-fast) var(--ep-ease-smooth-out);
}

.pl__layer.is-active {
  opacity: 1;
  pointer-events: auto;
  z-index: 1;
}

.pl__layer.is-hidden {
  opacity: 0;
  pointer-events: none;
  z-index: 0;
}

.pl__body {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 10px 18px 0 18px;
  background-color: var(--bgColor);
  vertical-align: top;
}

/* 双阶段装载门禁：幕后测距与落位期间 100% 遮挡视口，落定后平滑淡出 */
.pl__gate-skeleton {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  background-color: var(--bgColor);
  padding: 10px 18px 0 18px;
  box-sizing: border-box;
  overflow: hidden;
  transition: opacity 220ms var(--ep-ease-smooth-out);
  pointer-events: auto;
}

.pl__gate-skeleton.is-dismissed {
  opacity: 0;
  pointer-events: none;
}

.pl__body-pad {
  height: 6px;
}

/* 骨架屏占位：高保真模拟台词与说话人排版（错落有致的文本样式） */
.pl__skeleton {
  display: flex;
  flex-direction: column;
  width: 100%;
  margin-top: 4px;
  box-sizing: border-box;
}

.pl__sk-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  box-sizing: border-box;
  padding: 6px 4px 6px 14px;
  margin-bottom: 16px;
  border-left: 3px solid transparent;
  animation: skPulse 1.6s ease-in-out infinite;
}

.pl__sk-row--active {
  border-left-color: var(--ep-accent);
}

.pl__sk-row:nth-child(2) {
  animation-delay: 0.15s;
}

.pl__sk-row:nth-child(3) {
  animation-delay: 0.30s;
}

.pl__sk-row:nth-child(4) {
  animation-delay: 0.45s;
}

.pl__sk-row:nth-child(5) {
  animation-delay: 0.60s;
}

.pl__sk-row:nth-child(6) {
  animation-delay: 0.75s;
}

.pl__sk-speaker {
  height: 11px;
  border-radius: 4px;
  background-color: var(--ep-surface-inset);
  margin-bottom: 8px;
}

.pl__sk-row--active .pl__sk-speaker {
  background-color: var(--ep-accent);
  opacity: 0.7;
}

.pl__sk-line {
  height: 18px;
  border-radius: 6px;
  background-color: var(--ep-surface-inset);
  margin-bottom: 8px;
}

.pl__sk-line:last-child {
  margin-bottom: 0;
}

@keyframes skPulse {
  0%, 100% {
    opacity: 0.38;
  }
  50% {
    opacity: 0.82;
  }
}

/* 智能一键找回条（100% 完整复刻 iOS _buildFullWidthReturnBanner：Docked Full-Width Banner） */
.pl__locate-dock {
  flex: none;
  width: 100%;
  height: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  background-color: var(--ep-locate-bar-bg);
  transition: height 280ms var(--ep-ease-smooth-out),
              opacity 200ms var(--ep-ease-smooth-out);
}

.pl__locate-dock.is-open {
  height: var(--ep-locate-bar-h);
  opacity: 1;
  pointer-events: auto;
}

.pl__body::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  color: transparent !important;
}

.pl__locate {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  height: var(--ep-locate-bar-h);
  margin: 0;
  padding: 0 16px;
  background-color: var(--ep-locate-bar-bg);
  border-top: 1px solid var(--ep-locate-bar-border);
  border-radius: 0;
  box-shadow: none;
}

control-dock {
  display: block;
  flex: none;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
  vertical-align: top;
}

.pl__locate-ic {
  flex: none;
  width: var(--ep-locate-ic);
  height: var(--ep-locate-ic);
  border-radius: 50%;
  background-color: var(--ep-accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-my-location {
  width: var(--ep-locate-ic-glyph);
  height: var(--ep-locate-ic-glyph);
  background-color: var(--ep-accent);
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-image: url('data:image/svg+xml;base64,');
  mask-image: url('data:image/svg+xml;base64,');
}

.pl__locate-text {
  flex: 1;
  min-width: 0;
  margin-left: 8px;
  font-size: var(--ep-locate-font);
  font-weight: var(--ep-fw-bold);
  color: var(--ep-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 覆盖层 */
.pl__overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bgColor);
  z-index: 10;
}

.pl__overlay-text {
  font-size: var(--ep-font-continue-title);
  color: var(--ep-text-passed);
}

/* 试听截断锁定卡片 */
.pl__trial-lock-card {
  position: relative;
  margin: 20px 16px 32px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pl__trial-lock-mask {
  width: 100%;
  height: 48px;
  background: linear-gradient(to bottom, rgba(242, 237, 226, 0) 0%, var(--ep-surface-1) 100%);
  margin-top: -36px;
  margin-bottom: 8px;
  pointer-events: none;
}

.pl__trial-lock-box {
  width: 100%;
  box-sizing: border-box;
  padding: 24px 20px;
  border-radius: var(--ep-radius-card);
  background: var(--ep-surface-1);
  border: 1px dashed var(--ep-accent);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4px 20px rgba(204, 120, 92, 0.08);
}

.pl__trial-lock-icon {
  width: 18px;
  height: 16px;
  border-radius: 3px;
  background-color: var(--ep-accent);
  position: relative;
  box-sizing: border-box;
  margin-bottom: 12px;
}

.pl__trial-lock-icon::before {
  content: '';
  position: absolute;
  bottom: 100%;
  left: 3px;
  width: 12px;
  height: 10px;
  border: 2.5px solid var(--ep-accent);
  border-bottom: none;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  box-sizing: border-box;
}

.pl__trial-lock-title {
  font-size: 16px;
  font-weight: var(--ep-fw-bold);
  color: var(--ep-text-primary);
  margin-bottom: 6px;
}

.pl__trial-lock-desc {
  font-size: 12px;
  color: var(--ep-text-passed);
  margin-bottom: 18px;
  line-height: 1.5;
}

.pl__trial-lock-btn {
  width: 100% !important;
  height: 44px;
  border-radius: 22px;
  background: linear-gradient(135deg, #E08768 0%, var(--ep-accent) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4px 14px rgba(204, 120, 92, 0.3);
  margin: 0 !important;
  padding: 0 !important;
}

.pl__trial-lock-btn--hover {
  transform: scale(0.985);
  opacity: 0.92;
}

.pl__trial-lock-btn-text {
  font-size: 14px;
  font-weight: var(--ep-fw-bold);
  color: #FFFFFF;
}
