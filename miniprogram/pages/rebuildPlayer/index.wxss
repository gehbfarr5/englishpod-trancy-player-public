.page{padding:28rpx 30rpx 56rpx;color:#1d2733}.title{font-size:40rpx;font-weight:700;display:block;margin:12rpx 0 24rpx}.row{display:flex;gap:12rpx;margin:16rpx 0}.row button{font-size:25rpx;flex:1}.catalog{padding:20rpx;background:#f4f6f8;border-radius:18rpx;margin:20rpx 0 28rpx}.section-title{display:block;font-size:30rpx;font-weight:650;margin:12rpx 0}.search{height:76rpx;padding:0 20rpx;background:#fff;border-radius:12rpx;font-size:27rpx}.course-list{max-height:360rpx;margin-top:12rpx}.course{display:flex;align-items:center;justify-content:space-between;padding:18rpx 10rpx;border-bottom:1rpx solid #e1e5e9}.course-title{font-size:26rpx;flex:1}.course-level{font-size:22rpx;color:#687586;margin-left:16rpx}.more{font-size:24rpx;margin-top:12rpx}.empty{display:block;padding:20rpx;color:#758191}.transcript-heading{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.transcript-heading text{font-size:30rpx;font-weight:650}.transcript-heading button{font-size:22rpx;margin:0}.transcript{height:54vh;margin-top:12rpx;padding:0 12rpx;border-radius:14rpx;background:#fafbfc}.line{display:block;padding:20rpx 16rpx;line-height:1.65;border-bottom:1rpx solid #e6e9ed;font-size:28rpx;color:#394655}.line.active{background:#e8f1ff;color:#174b8b;border-left:6rpx solid #3978d6}.line.section{font-size:23rpx;font-weight:700;color:#798493}.speaker{display:block;font-size:20rpx;font-weight:700;letter-spacing:1rpx;color:#728096;margin-bottom:6rpx}
