.screen {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  color: var(--ep-text-primary);
  background: var(--bgColor);
}

.catalog-screen,
.player-screen {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.catalog-screen {
  padding: calc(env(safe-area-inset-top) + 24rpx) 32rpx 0;
}

.catalog-header {
  flex: none;
  padding: 12rpx 4rpx 24rpx;
}

.eyebrow {
  display: block;
  color: var(--ep-accent);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.catalog-title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 800;
}

.catalog-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--ep-text-passed);
  font-size: 25rpx;
  line-height: 1.55;
}

.continue-card {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 118rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--ep-deck-border);
  border-radius: 24rpx;
  background: var(--ep-deck-bg);
}

.continue-copy { min-width: 0; display: flex; flex-direction: column; }
.continue-label { color: var(--ep-accent); font-size: 21rpx; font-weight: 700; }
.continue-title { max-width: 540rpx; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 700; }
.continue-meta { margin-top: 5rpx; color: var(--ep-text-passed); font-size: 21rpx; }
.continue-action { flex: none; margin-left: 18rpx; padding: 13rpx 22rpx; border-radius: 999rpx; color: var(--ep-accent-fg); background: var(--ep-accent); font-size: 23rpx; font-weight: 700; }

.search-wrap {
  flex: none;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--ep-border);
  border-radius: 18rpx;
  background: var(--ep-surface-1);
}

.search-icon { flex: none; margin-right: 12rpx; color: var(--ep-text-passed); font-size: 36rpx; line-height: 1; }
.search { flex: 1; min-width: 0; height: 100%; color: var(--ep-text-primary); font-size: 25rpx; }
.clear-search { flex: none; padding: 14rpx 0 14rpx 14rpx; color: var(--ep-accent); font-size: 22rpx; }

.list-caption {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 6rpx 14rpx;
  color: var(--ep-text-passed);
  font-size: 21rpx;
  font-weight: 700;
}

.course-list { flex: 1; height: 0; min-height: 0; padding-bottom: env(safe-area-inset-bottom); }
.course-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 112rpx;
  margin-bottom: 12rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid var(--ep-border);
  border-radius: 20rpx;
  background: var(--ep-surface-1);
}
.course-card.is-current { border-color: var(--ep-accent); background: var(--ep-accent-soft); }
.course-index { flex: none; display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; margin-right: 18rpx; border-radius: 20rpx; color: var(--ep-accent); background: var(--ep-surface-inset); font-size: 22rpx; font-weight: 800; }
.course-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.course-title { overflow: hidden; color: var(--ep-text-primary); font-size: 27rpx; line-height: 1.35; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.course-level { margin-top: 7rpx; color: var(--ep-text-passed); font-size: 21rpx; }
.course-chevron { flex: none; margin-left: 12rpx; color: var(--ep-text-passed); font-size: 42rpx; line-height: 1; }
.more-button { width: 100%; height: 78rpx; margin: 8rpx 0 24rpx; border: 1rpx solid var(--ep-border); border-radius: 18rpx; color: var(--ep-text-primary); background: var(--ep-surface-1); font-size: 24rpx; line-height: 78rpx; }
.empty-state { padding: 44rpx 24rpx; color: var(--ep-text-passed); text-align: center; font-size: 25rpx; }

.player-screen { padding-top: env(safe-area-inset-top); }
.player-header { flex: none; padding: 16rpx 32rpx 20rpx; background: var(--ep-deck-bg); border-bottom: 1rpx solid var(--ep-border); }
.player-topline { display: flex; align-items: center; justify-content: space-between; min-height: 62rpx; }
.player-topline .eyebrow { max-width: 390rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.text-button { flex: none; min-width: 86rpx; height: 64rpx; margin: 0; padding: 0 12rpx; border: 0; border-radius: 999rpx; color: var(--ep-accent); background: transparent; font-size: 23rpx; line-height: 64rpx; }
.share-button { color: var(--ep-text-primary); }
.player-title { display: block; margin-top: 15rpx; font-size: 38rpx; line-height: 1.28; font-weight: 800; }
.playback-status { display: flex; align-items: center; margin-top: 10rpx; color: var(--ep-text-passed); font-size: 22rpx; }
.status-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: var(--ep-surface-3); }
.status-dot.is-playing { background: var(--ep-accent); }

.content-tabs { flex: none; display: flex; margin: 18rpx 28rpx 0; padding: 7rpx; border: 1rpx solid var(--ep-border); border-radius: 19rpx; background: var(--ep-surface-inset); }
.tab { flex: 1; min-width: 0; padding: 16rpx 4rpx; border-radius: 14rpx; color: var(--ep-text-passed); text-align: center; font-size: 22rpx; font-weight: 700; }
.tab.is-active { color: var(--ep-accent-fg); background: var(--ep-accent); }
.transcript-tools { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 34rpx 4rpx; }
.content-heading { display: block; color: var(--ep-text-passed); font-size: 21rpx; font-weight: 700; }
.content-heading-single { flex: none; padding: 22rpx 34rpx 10rpx; }
.locate-button { flex: none; height: 58rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid var(--ep-border); border-radius: 999rpx; color: var(--ep-accent); background: var(--ep-surface-1); font-size: 20rpx; line-height: 56rpx; }
.locate-button[disabled] { opacity: .45; }

.content-scroll { flex: 1; width: 100%; height: 0; min-height: 0; box-sizing: border-box; }
.transcript-list { padding: 8rpx 32rpx 20rpx; }
.transcript-line { box-sizing: border-box; display: flex; flex-direction: column; padding: 17rpx 16rpx 18rpx 22rpx; margin-bottom: 5rpx; border-left: 4rpx solid transparent; color: var(--ep-text-passed); }
.transcript-line.is-active { border-left-color: var(--ep-accent); color: var(--ep-text-primary); background: var(--ep-accent-soft); }
.transcript-line.is-section { padding-top: 26rpx; padding-bottom: 10rpx; color: var(--ep-accent); }
.speaker { display: block; margin-bottom: 5rpx; color: var(--ep-accent); font-size: 20rpx; line-height: 1.4; font-weight: 800; letter-spacing: 1rpx; }
.line-text { display: block; font-size: 30rpx; line-height: 1.55; }
.transcript-line.is-section .line-text { font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; }
.dialogue-line { border-left-color: transparent; }
.vocab-list { padding: 8rpx 28rpx 18rpx; }
.vocab-card { padding: 20rpx 22rpx; margin-bottom: 12rpx; border: 1rpx solid var(--ep-border); border-radius: 18rpx; background: var(--ep-surface-1); }
.vocab-word-row { display: flex; align-items: baseline; }
.vocab-word { color: var(--ep-accent); font-size: 29rpx; font-weight: 800; }
.vocab-pos { margin-left: 14rpx; color: var(--ep-text-passed); font-size: 21rpx; }
.vocab-definition { display: block; margin-top: 8rpx; color: var(--ep-text-primary); font-size: 25rpx; line-height: 1.5; }
.scroll-tail { height: 24rpx; }
.content-empty { margin-top: 32rpx; }

.player-dock { flex: none; box-sizing: border-box; padding: 12rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--ep-border); background: var(--ep-bottom-bg); }
.error-banner { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 16rpx; margin-bottom: 12rpx; border-radius: 14rpx; color: #9b3429; background: rgba(204, 92, 76, .12); font-size: 21rpx; }
.error-banner button { flex: none; margin: 0 0 0 12rpx; font-size: 20rpx; }
.progress-row { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; color: var(--ep-text-passed); font-size: 20rpx; font-variant-numeric: tabular-nums; }
.progress-slider { margin: 2rpx 0 4rpx; padding: 0; }
.transport-row { display: flex; align-items: center; justify-content: center; margin-top: 4rpx; }
.transport-side { flex: 1; max-width: 190rpx; height: 76rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid var(--ep-border); border-radius: 17rpx; color: var(--ep-text-primary); background: var(--ep-surface-1); font-size: 23rpx; line-height: 74rpx; }
.transport-main { flex: 1.4; max-width: 250rpx; height: 82rpx; margin: 0 14rpx; padding: 0 18rpx; border: 0; border-radius: 22rpx; color: var(--ep-accent-fg); background: var(--ep-accent); font-size: 28rpx; line-height: 82rpx; font-weight: 800; }
.transport-side[disabled], .transport-main[disabled] { opacity: .42; }

button::after { border: 0; }
