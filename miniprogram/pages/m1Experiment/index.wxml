<view class="m1-page">
  <view class="m1-header">
    <text class="m1-eyebrow">DEVELOPMENT EXPERIMENT · M1</text>
    <text class="m1-title">{{lessonTitle}}</text>
    <text class="m1-subtitle">One Podcast audio session. Transcript and vocabulary views do not control audio.</text>
  </view>

  <view wx:if="{{isBlocked}}" class="m1-card">
    <text class="m1-status">{{blockReason}}</text>
  </view>

  <block wx:else>
    <view class="m1-card">
      <text class="m1-status">{{status}}</text>
      <view class="m1-progress">
        <text>{{positionLabel}}</text>
        <slider
          min="0"
          max="{{durationSec || 1}}"
          value="{{positionSec}}"
          disabled="{{!sourceLoaded}}"
          activeColor="#2f6b55"
          backgroundColor="#dce4df"
          block-size="18"
          bindchange="onSeekChange"
        />
        <text>{{durationLabel}}</text>
      </view>
      <view class="m1-controls">
        <button
          class="m1-primary"
          disabled="{{isLoadingLesson || isStarting || !sourceLoaded && !status}}"
          bindtap="onStartPodcast"
        >{{sourceLoaded ? 'Podcast loaded' : 'Play Podcast'}}</button>
        <button
          class="m1-secondary"
          disabled="{{!sourceLoaded}}"
          bindtap="onTogglePlayback"
        >{{isPlaying ? 'Pause' : 'Resume'}}</button>
      </view>
    </view>

    <view class="m1-card">
      <text class="m1-section-title">Content views</text>
      <view class="m1-tabs">
        <button
          wx:for="{{viewButtons}}"
          wx:key="key"
          class="m1-tab {{currentView === item.key ? 'm1-tab--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectView"
        >{{item.label}}</button>
      </view>

      <scroll-view class="m1-content" scroll-y>
        <block wx:if="{{currentView === 'pb'}}">
          <view wx:for="{{pbSegments}}" wx:key="id" class="m1-line">
            <text class="m1-speaker" wx:if="{{item.speaker}}">{{item.speaker}}</text>
            <text>{{item.text}}</text>
          </view>
          <text wx:if="{{pbSegments.length === 0}}" class="m1-empty">No Podcast transcript is available.</text>
        </block>
        <block wx:elif="{{currentView === 'dg'}}">
          <view wx:for="{{dgSegments}}" wx:key="id" class="m1-line">
            <text class="m1-speaker" wx:if="{{item.speaker}}">{{item.speaker}}</text>
            <text>{{item.text}}</text>
          </view>
          <text wx:if="{{dgSegments.length === 0}}" class="m1-empty">No Dialogue transcript is available.</text>
        </block>
        <block wx:else>
          <view wx:for="{{vocabulary}}" wx:key="word" class="m1-vocab">
            <text class="m1-vocab-word">{{item.word}} <text class="m1-vocab-pos">{{item.pos}}</text></text>
            <text class="m1-vocab-definition">{{item.definition}}</text>
          </view>
          <text wx:if="{{vocabulary.length === 0}}" class="m1-empty">No vocabulary is available.</text>
        </block>
      </scroll-view>
    </view>

    <view class="m1-evidence">
      <text>{{commandSummary}}</text>
      <text wx:if="{{lastErrorCode}}">Audio error code: {{lastErrorCode}}</text>
      <text>Evidence excludes audio URLs, file IDs, learner data and lesson content.</text>
    </view>
  </block>

  <button class="m1-exit" bindtap="onExitExperiment">Exit experiment</button>
</view>
