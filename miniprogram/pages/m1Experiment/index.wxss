page {
  min-height: 100%;
  background: #f4f6f4;
  color: #202923;
}

.m1-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 30rpx calc(36rpx + env(safe-area-inset-bottom));
}

.m1-header {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 4rpx 26rpx;
}

.m1-eyebrow {
  color: #668174;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.m1-title {
  color: #1d3026;
  font-size: 42rpx;
  font-weight: 700;
}

.m1-subtitle {
  color: #66736b;
  font-size: 25rpx;
  line-height: 1.5;
}

.m1-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #e0e7e2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(28, 55, 40, 0.04);
}

.m1-status {
  display: block;
  color: #345945;
  font-size: 25rpx;
  line-height: 1.45;
}

.m1-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  color: #66736b;
  font-size: 21rpx;
}

.m1-progress slider {
  flex: 1;
  margin: 0;
}

.m1-controls {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.m1-primary,
.m1-secondary,
.m1-exit,
.m1-tab {
  box-sizing: border-box;
  margin: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 2.5;
}

.m1-primary {
  flex: 1;
  background: #2f6b55;
  color: #ffffff;
}

.m1-secondary {
  width: 190rpx;
  background: #e8efea;
  color: #2f604a;
}

.m1-section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #26372d;
  font-size: 27rpx;
  font-weight: 700;
}

.m1-tabs {
  display: flex;
  gap: 10rpx;
}

.m1-tab {
  flex: 1;
  padding: 0 10rpx;
  background: #f0f3f1;
  color: #5e6d63;
  font-size: 20rpx;
  line-height: 2.6;
  white-space: normal;
}

.m1-tab--active {
  background: #dcebe1;
  color: #24533c;
  font-weight: 700;
}

.m1-content {
  box-sizing: border-box;
  height: 440rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f7f9f7;
}

.m1-line,
.m1-vocab {
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid #e7ece8;
  color: #35443a;
  font-size: 25rpx;
  line-height: 1.55;
}

.m1-speaker {
  display: block;
  margin-bottom: 4rpx;
  color: #688276;
  font-size: 20rpx;
  font-weight: 700;
}

.m1-vocab-word {
  display: block;
  color: #26372d;
  font-weight: 700;
}

.m1-vocab-pos {
  color: #76847a;
  font-size: 21rpx;
  font-weight: 400;
}

.m1-vocab-definition {
  display: block;
  margin-top: 5rpx;
  color: #58675d;
}

.m1-empty {
  color: #7b877e;
  font-size: 23rpx;
}

.m1-evidence {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 6rpx 18rpx;
  color: #718077;
  font-size: 19rpx;
  line-height: 1.45;
}

.m1-exit {
  width: 100%;
  background: transparent;
  color: #68776d;
  font-size: 23rpx;
}
