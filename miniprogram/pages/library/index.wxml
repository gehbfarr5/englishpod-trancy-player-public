<!--
  EnglishPod 课程库（pages/library/index.wxml）
  纯 WebView 原生页面，搭载秒开骨架屏、即时存储缓存、分片平滑滚动。
  已精简：移除顶部筛选 pills 与独立卡片，主页全量展示课程列表并在列表中管理进度；
  点击标题栏（EnglishPod）直接跳转当前正在收听的课程。
-->
<view class="app-root notranslate" translate="no">
  <pinned-top-deck
    app-name="{{appName}}"
    subtitle="{{subtitle}}"
    completion-text="{{completionText}}"
    safe-top-px="{{safeTopPx}}"
    nav-bar-px="{{navBarPx}}"
    bind:titleTap="onTitleTap"
  />

  <!-- 内凹滚动列表区 -->
  <scroll-view
    class="lib__well"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation="{{false}}"
    bindscroll="onWellScroll"
    bindscrolltolower="onWellScrollToLower"
  >
    <view class="lib__well-head">
      <text class="lib__well-title">COURSE LIST</text>
      <text class="lib__well-hint">SCROLL TO BROWSE ↓</text>
    </view>

    <!-- 加载骨架屏（首次无缓存时展示） -->
    <view wx:if="{{isIndexLoading && visibleLessons.length === 0}}" class="lib__skeleton">
      <view class="lib__sk-card" wx:for="{{[1, 2, 3, 4, 5, 6]}}" wx:key="*this">
        <view class="lib__sk-circle"></view>
        <view class="lib__sk-lines">
          <view class="lib__sk-line lib__sk-line--title"></view>
          <view class="lib__sk-line lib__sk-line--sub"></view>
        </view>
      </view>
    </view>

    <!-- 课程列表（分片增量加载，335 课 60fps 瞬间呈现） -->
    <view wx:else class="lib__list">
      <lesson-card
        wx:for="{{renderedLessons}}"
        wx:key="lessonId"
        class="lib__card"
        lesson-id="{{item.lessonId}}"
        index-text="{{item.indexText}}"
        title="{{item.title}}"
        level="{{item.level}}"
        status-label="{{item.statusLabel}}"
        is-done="{{item.isDone}}"
        is-current="{{item.isCurrent}}"
        highlight="{{item.highlight}}"
        bar-value="{{item.barValue}}"
        bar-percent="{{item.barPercent}}"
        bind:lessonTap="onLessonTap"
      />
    </view>

    <view wx:if="{{!isIndexLoading && visibleLessons.length === 0}}" class="lib__empty">
      <text class="lib__empty-text">{{emptyHint}}</text>
    </view>

    <view class="lib__footer-space"></view>
  </scroll-view>
</view>
