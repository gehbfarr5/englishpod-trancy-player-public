/* 遮罩层 */
.unlock-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 280ms cubic-bezier(0.25, 1, 0.5, 1);
}

.unlock-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

/* 底部抽屉容器 */
.unlock-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 16px 20px calc(24px + env(safe-area-inset-bottom)) 20px;
  background-color: var(--ep-surface-1);
  border-top-left-radius: 24px;
  border-top-right-radius: 24px;
  box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.18);
  transform: translateY(100%);
  transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

.unlock-mask.is-visible .unlock-sheet {
  transform: translateY(0);
}

/* 顶部操作条（把手与关闭键） */
.unlock-sheet__header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  margin-bottom: 12px;
}

.unlock-sheet__grabber {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--ep-border);
}

.unlock-sheet__close {
  position: absolute;
  right: -4px;
  top: -4px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--ep-surface-inset);
}

.unlock-sheet__close--hover {
  opacity: 0.7;
}

.unlock-sheet__close-text {
  font-size: 14px;
  color: var(--ep-text-passed);
  font-weight: 500;
  line-height: 1;
}

/* 勋章与标题 */
.unlock-sheet__badge-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 18px;
}

.unlock-sheet__badge {
  padding: 3px 10px;
  border-radius: 12px;
  background: linear-gradient(135deg, #E89E78 0%, var(--ep-accent) 100%);
  margin-bottom: 8px;
}

.unlock-sheet__badge-text {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  color: #FFFFFF;
}

.unlock-sheet__title {
  font-size: 19px;
  font-weight: 700;
  color: var(--ep-text-primary);
  margin-bottom: 4px;
}

.unlock-sheet__subtitle {
  font-size: 12px;
  color: var(--ep-text-passed);
}

/* 价格卡片 */
.unlock-sheet__price-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-radius: 16px;
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
  margin-bottom: 18px;
}

.unlock-sheet__price-left {
  display: flex;
  flex-direction: column;
}

.unlock-sheet__price-tag {
  font-size: 14px;
  font-weight: 700;
  color: var(--ep-accent);
  margin-bottom: 2px;
}

.unlock-sheet__price-desc {
  font-size: 11px;
  color: var(--ep-text-passed);
}

.unlock-sheet__price-right {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.unlock-sheet__currency {
  font-size: 16px;
  font-weight: 700;
  color: var(--ep-accent);
  margin-right: 2px;
}

.unlock-sheet__amount {
  font-size: 30px;
  font-weight: 800;
  color: var(--ep-accent);
  letter-spacing: -0.5px;
}

/* 权益列表 */
.unlock-sheet__benefits {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.benefit-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.benefit-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background-color: var(--ep-surface-inset);
  color: var(--ep-accent);
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  margin-top: 1px;
  flex-shrink: 0;
}

.benefit-info {
  display: flex;
  flex-direction: column;
}

.benefit-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--ep-text-primary);
  margin-bottom: 1px;
}

.benefit-sub {
  font-size: 11px;
  color: var(--ep-text-passed);
}

/* 底部行动按钮 */
.unlock-sheet__action {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.unlock-btn {
  width: 100% !important;
  height: 48px;
  border-radius: 24px;
  background: linear-gradient(135deg, #E08768 0%, var(--ep-accent) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4px 16px rgba(204, 120, 92, 0.35);
  transition: transform 120ms ease, opacity 120ms ease;
  margin: 0 !important;
  padding: 0 !important;
}

.unlock-btn--hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.unlock-btn__text {
  font-size: 15px;
  font-weight: 700;
  color: #FFFFFF;
}

.unlock-btn.is-loading {
  opacity: 0.7;
}

.unlock-sheet__tip {
  margin-top: 10px;
  font-size: 11px;
  color: var(--ep-text-upcoming);
  text-align: center;
}
