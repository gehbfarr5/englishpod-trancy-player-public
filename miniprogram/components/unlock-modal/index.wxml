<!-- 解锁弹窗底抽屉 -->
<view class="unlock-mask {{visible ? 'is-visible' : ''}}" bindtap="onClose">
  <view class="unlock-sheet {{visible ? 'is-open' : ''}}" catchtap="noop">
    <!-- 顶部拖拽把手（极简纯粹，点击遮罩空白区域即可关闭） -->
    <view class="unlock-sheet__header">
      <view class="unlock-sheet__grabber"></view>
    </view>

    <!-- 弹窗内容主体 -->
    <view class="unlock-sheet__content">
      <!-- 大标题 -->
      <view class="unlock-sheet__badge-box">
        <text class="unlock-sheet__title">解锁全套 EnglishPod 课程</text>
        <text class="unlock-sheet__subtitle">前 10 课完全免费试听 · 解锁后永久畅听全量 335 课</text>
      </view>

      <!-- 价格标牌 -->
      <view class="unlock-sheet__price-card">
        <view class="unlock-sheet__price-left">
          <text class="unlock-sheet__price-tag">终身买断特惠</text>
          <text class="unlock-sheet__price-desc">包含全套 335 课完整音频与原版台本</text>
        </view>
        <view class="unlock-sheet__price-right">
          <text class="unlock-sheet__currency">¥</text>
          <text class="unlock-sheet__amount">{{priceYuan}}</text>
        </view>
      </view>

      <!-- 权益列表（真实功能描述，剔除未上线承诺） -->
      <view class="unlock-sheet__benefits">
        <view class="benefit-item">
          <text class="benefit-icon">✓</text>
          <view class="benefit-info">
            <text class="benefit-title">全量 335 门原版剧集无限畅听</text>
            <text class="benefit-sub">无截断无限畅听，完整体验全部剧集内容</text>
          </view>
        </view>
        <view class="benefit-item">
          <text class="benefit-icon">✓</text>
          <view class="benefit-info">
            <text class="benefit-title">后续升级功能持续享有</text>
            <text class="benefit-sub">后续新功能升级优先体验，保障全功能完整使用</text>
          </view>
        </view>
        <view class="benefit-item">
          <text class="benefit-icon">✓</text>
          <view class="benefit-info">
            <text class="benefit-title">一次开通终身有效</text>
            <text class="benefit-sub">微信账号专属绑定，进度断点记忆跨设备接续</text>
          </view>
        </view>
      </view>

      <!-- 底部行动按钮 -->
      <view class="unlock-sheet__action">
        <button
          class="unlock-btn {{loading ? 'is-loading' : ''}}"
          hover-class="unlock-btn--hover"
          disabled="{{loading}}"
          bindtap="onUnlock"
        >
          <text class="unlock-btn__text">{{loading ? '处理中...' : '立即开通 · 永久有效 ¥' + priceYuan}}</text>
        </button>
        <text class="unlock-sheet__tip">通过微信官方虚拟支付安全结算，一次付费永久拥有</text>
      </view>
    </view>
  </view>
</view>
