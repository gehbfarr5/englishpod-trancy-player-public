/* 进度条 */
.ccard__bar {
  margin-top: var(--ep-space-sm);
  height: var(--ep-radius-bar);
  border-radius: var(--ep-radius-bar);
  background-color: var(--ep-border);
  overflow: hidden;
}

.ccard__bar-fill {
  height: 100%;
  border-radius: var(--ep-radius-bar);
  background-color: var(--ep-accent);
}
