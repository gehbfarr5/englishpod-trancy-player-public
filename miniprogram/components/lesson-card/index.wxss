/* 课程卡片 —— 全部尺寸/颜色走 CSS 令牌 */
.lcard {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: var(--ep-card-h);
  padding: var(--ep-space-md);
  margin-bottom: var(--ep-card-gap);
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-border);
  contain: content;
  content-visibility: auto;
  contain-intrinsic-size: auto var(--ep-card-h);
  transition: transform var(--ep-dur-fast) var(--ep-ease-smooth-out);
}

.lcard:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.lcard.is-current {
  border-color: var(--ep-accent);
}

/* 序号 / 完成标记 Squircle (36x36) */
.lcard__squircle {
  flex: none;
  width: 36px;
  height: 36px;
  margin-right: var(--ep-space-sm);
  border-radius: 10px;
  background-color: var(--ep-surface-inset);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lcard.is-done .lcard__squircle {
  background-color: var(--ep-accent-soft);
}

.lcard__index-text {
  font-size: var(--ep-font-card-index);
  font-weight: var(--ep-fw-heavy);
  color: var(--ep-text-passed);
}

.lcard.is-done .lcard__index-text {
  color: var(--ep-accent);
}

.lcard.is-current .lcard__index-text {
  color: var(--ep-accent);
}

.lcard__main {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-right: var(--ep-space-sm);
}

.lcard__title {
  font-size: var(--ep-font-card-title);
  font-weight: var(--ep-fw-semibold);
  color: var(--ep-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lcard__level {
  margin-top: 2px;
  font-size: var(--ep-font-card-level);
  font-weight: var(--ep-fw-medium);
  color: var(--ep-text-passed);
}

.lcard__bar {
  margin-top: 6px;
  height: var(--ep-radius-bar);
  border-radius: var(--ep-radius-bar);
  background-color: var(--ep-border);
  overflow: hidden;
}

.lcard__bar-fill {
  height: 100%;
  border-radius: var(--ep-radius-bar);
  background-color: var(--ep-accent);
}

.lcard__status {
  flex: none;
  display: flex;
  align-items: center;
  padding: 3px 9px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-surface-inset);
}

.lcard__lock-ic {
  width: 8px;
  height: 7px;
  margin-right: 4px;
  border-radius: 1.5px;
  background-color: var(--ep-text-passed);
  position: relative;
  box-sizing: border-box;
  flex-shrink: 0;
}

.lcard__lock-ic::before {
  content: '';
  position: absolute;
  bottom: 100%;
  left: 1.5px;
  width: 5px;
  height: 4px;
  border: 1.5px solid var(--ep-text-passed);
  border-bottom: none;
  border-top-left-radius: 2.5px;
  border-top-right-radius: 2.5px;
  box-sizing: border-box;
}

.lcard__status.is-highlight .lcard__lock-ic {
  background-color: var(--ep-accent);
}

.lcard__status.is-highlight .lcard__lock-ic::before {
  border-color: var(--ep-accent);
}

.lcard__status.is-highlight {
  background-color: var(--ep-accent-soft);
}

.lcard__status-text {
  font-size: var(--ep-font-card-status);
  font-weight: var(--ep-fw-bold);
  color: var(--ep-text-passed);
}

.lcard__status.is-highlight .lcard__status-text {
  color: var(--ep-accent);
}
