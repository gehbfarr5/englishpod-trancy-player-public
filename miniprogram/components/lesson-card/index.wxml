<!--
  课程卡片
  - 左：序号（固定列宽）；中：标题 + level + 进度条；右：完成度角标。
  - 点击直接触发 lessonTap。
-->
<view
  class="lcard {{isCurrent ? 'is-current' : ''}} {{isDone ? 'is-done' : ''}} {{isLocked ? 'is-locked' : ''}}"
  data-lesson-id="{{lessonId}}"
  bindtap="onTap"
>
  <!-- 序号 / 完成标记 Squircle (36x36) -->
  <view class="lcard__squircle">
    <text class="lcard__index-text">{{isDone ? '✓' : indexText}}</text>
  </view>

  <view class="lcard__main">
    <text class="lcard__title">{{title}}</text>
    <text class="lcard__level">{{level}}</text>
    <view class="lcard__bar">
      <view class="lcard__bar-fill" style="width: {{barPercent}}%;"></view>
    </view>
  </view>

  <view class="lcard__status {{highlight ? 'is-highlight' : ''}} {{isLocked ? 'is-locked' : ''}}">
    <view wx:if="{{isLocked && !isDone}}" class="lcard__lock-ic"></view>
    <text class="lcard__status-text">{{isLocked && !isDone ? (statusLabel === 'New' ? '试听' : statusLabel) : statusLabel}}</text>
  </view>
</view>
