<!-- 多端学习进度同步弹窗（移动端原生 Bottom Sheet：下拉或点空白遮罩关闭，无右上角关闭按钮） -->
<view class="sync-mask {{visible ? 'is-visible' : ''}}" bindtap="onClose">
  <view
    class="sync-sheet {{visible ? 'is-open' : ''}} {{dragging ? 'is-dragging' : ''}}"
    style="{{dragging ? 'transform: translate3d(0, ' + dragOffsetPx + 'px, 0);' : ''}}"
    catchtap="noop"
  >
    <!-- 顶部拖拽把手（支持下拉关闭） -->
    <view
      class="sync-sheet__grabber-wrap"
      bindtouchstart="onSheetTouchStart"
      bindtouchmove="onSheetTouchMove"
      bindtouchend="onSheetTouchEnd"
    >
      <view class="sync-sheet__grabber"></view>
    </view>

    <!-- 提示横幅 -->
    <view wx:if="{{revokedNotice || errorMessage}}" class="sync-banner">
      <text class="sync-banner__text">{{revokedNotice ? '此设备已被移出同步组，本机所有学习记录已完整保留。' : errorMessage}}</text>
      <text class="sync-banner__dismiss" bindtap="onDismissNotice">知道了</text>
    </view>

    <!-- 视图 1：展示本机二维码 -->
    <view wx:if="{{subView === 'qr'}}" class="sync-panel">
      <view
        class="sync-subhead"
        bindtouchstart="onSheetTouchStart"
        bindtouchmove="onSheetTouchMove"
        bindtouchend="onSheetTouchEnd"
      >
        <view class="sync-back-btn" hover-class="sync-btn--hover" bindtap="onCancelSubView">
          <text class="sync-back-btn__text">‹ 返回</text>
        </view>
        <text class="sync-subhead__title">本机配对二维码</text>
      </view>

      <view class="sync-qr-card">
        <view wx:if="{{displayCode}}" class="sync-qr-frame">
          <canvas
            id="syncQrCanvas"
            type="2d"
            class="sync-qr__canvas"
            style="width: {{qrSizePx}}px; height: {{qrSizePx}}px;"
          />
        </view>
        <view wx:else class="sync-qr-placeholder">
          <text class="sync-qr-placeholder__text">{{busy ? '正在生成配对码…' : '暂无可用配对码'}}</text>
        </view>

        <view wx:if="{{displayCode}}" class="sync-code-row">
          <text class="sync-qr-code">{{displayCode}}</text>
          <view class="sync-copy-chip" hover-class="sync-btn--hover" bindtap="onCopyCode">
            <text class="sync-copy-chip__text">复制</text>
          </view>
        </view>

        <text class="sync-qr-countdown {{ticketExpired ? 'is-warn' : ''}}">
          {{ticketExpired ? '配对码已过期，请重新生成' : '5 分钟有效 · 剩余 ' + countdownText}}
        </text>

        <view wx:if="{{ticketExpired}}" class="sync-btn sync-btn--primary sync-qr-regen" hover-class="sync-btn--hover" bindtap="onGenerateCode">
          <text class="sync-btn__text">重新生成配对码</text>
        </view>
      </view>

      <view class="sync-subtle-link" hover-class="sync-btn--hover" bindtap="onScanQr">
        <text class="sync-subtle-link__text">改为扫另一台设备的二维码</text>
      </view>
    </view>

    <!-- 视图 2：手动输入 8 位配对码（分格输入） -->
    <view wx:elif="{{subView === 'code'}}" class="sync-panel">
      <view
        class="sync-subhead"
        bindtouchstart="onSheetTouchStart"
        bindtouchmove="onSheetTouchMove"
        bindtouchend="onSheetTouchEnd"
      >
        <view class="sync-back-btn" hover-class="sync-btn--hover" bindtap="onCancelSubView">
          <text class="sync-back-btn__text">‹ 返回</text>
        </view>
        <text class="sync-subhead__title">{{hasLinkedPeers ? '输入配对码关联设备' : '输入配对码连接'}}</text>
      </view>

      <text class="sync-code-hint">
        请输入另一台设备显示的 8 位配对码{{hasLinkedPeers ? '（将与当前组智能合并）' : ''}}
      </text>

      <view class="sync-code-boxes" bindtap="onFocusCodeInput">
        <block wx:for="{{codeCells}}" wx:key="index">
          <text wx:if="{{index === 4}}" class="sync-code-dash">-</text>
          <view class="sync-code-cell {{item.filled ? 'is-filled' : ''}} {{item.active ? 'is-active' : ''}}">
            <text class="sync-code-cell__char">{{item.char}}</text>
          </view>
        </block>
        <input
          class="sync-code-hidden-input"
          type="text"
          maxlength="9"
          focus="{{codeFocus}}"
          value="{{codeInput}}"
          bindinput="onCodeInput"
          bindconfirm="onSubmitCode"
        />
      </view>

      <view
        class="sync-btn sync-btn--primary {{!codeReady || busy ? 'is-disabled' : ''}}"
        hover-class="sync-btn--hover"
        bindtap="onSubmitCode"
      >
        <text class="sync-btn__text">{{busy ? '连接中…' : (hasLinkedPeers ? '确认关联并合并进度' : '确认连接')}}</text>
      </view>

      <view class="sync-subtle-link" hover-class="sync-btn--hover" bindtap="onScanQr">
        <text class="sync-subtle-link__text">改为打开相机扫码</text>
      </view>
    </view>

    <!-- 视图 3：未配对首页（含单机展码未扫） -->
    <view wx:elif="{{!hasLinkedPeers}}" class="sync-panel">
      <view
        class="sync-head"
        bindtouchstart="onSheetTouchStart"
        bindtouchmove="onSheetTouchMove"
        bindtouchend="onSheetTouchEnd"
      >
        <view class="sync-head__titles">
          <text class="sync-head__title">多端进度同步</text>
          <text class="sync-head__sub">本机已学 {{completedCount}} / {{totalCount}} 课 · 未连接其他设备</text>
        </view>
      </view>

      <view class="sync-dual-grid">
        <view class="sync-dir-tile is-primary" hover-class="sync-btn--hover" bindtap="onScanQr">
          <view class="sync-dir-tile__ico is-primary">
            <view class="sync-ico sync-ico--scan sync-ico--accent-fg"></view>
          </view>
          <text class="sync-dir-tile__title">扫码连接</text>
          <text class="sync-dir-tile__desc">扫描另一台设备二维码</text>
        </view>

        <view class="sync-dir-tile" hover-class="sync-btn--hover" bindtap="onGenerateCode">
          <view class="sync-dir-tile__ico">
            <view class="sync-ico sync-ico--qr sync-ico--accent"></view>
          </view>
          <text class="sync-dir-tile__title">展示二维码</text>
          <text class="sync-dir-tile__desc">让另一台设备扫我</text>
        </view>
      </view>

      <view class="sync-manual-row" hover-class="sync-btn--hover" bindtap="onShowCodeInput">
        <text class="sync-manual-row__text">手动输入 8 位配对码</text>
        <text class="sync-manual-row__arrow">›</text>
      </view>
    </view>

    <!-- 视图 4：已加入同步组（参考微信输入法 342.jpg，无右上角关闭按钮） -->
    <view wx:else class="sync-panel">
      <view
        class="sync-head"
        bindtouchstart="onSheetTouchStart"
        bindtouchmove="onSheetTouchMove"
        bindtouchend="onSheetTouchEnd"
      >
        <view class="sync-head__titles">
          <text class="sync-head__title">多端进度同步</text>
          <view class="sync-status-row">
            <view class="sync-status-dot {{status === 'offline' || status === 'error' ? 'is-warn' : ''}}"></view>
            <text class="sync-head__sub">{{statusLabel}}</text>
          </view>
        </view>
        <view class="sync-icon-btn {{busy ? 'is-busy' : ''}}" hover-class="sync-btn--hover" bindtap="onSyncNow">
          <view class="sync-ico sync-ico--sync sync-ico--muted"></view>
        </view>
      </view>

      <text class="sync-section-label">我的设备 ({{deviceCount}})</text>

      <view class="sync-devices-card">
        <scroll-view
          class="sync-devices-scroll"
          scroll-y="{{deviceCount > 3}}"
          show-scrollbar="{{false}}"
        >
          <view wx:for="{{devices}}" wx:key="deviceId" class="sync-device-row {{item.isCurrent ? 'is-self' : ''}}">
            <view class="sync-device-row__ico {{item.isCurrent ? 'is-self' : ''}}">
              <view class="sync-ico {{item.isWeb ? 'sync-ico--laptop' : 'sync-ico--phone'}} {{item.isCurrent ? 'sync-ico--accent' : 'sync-ico--muted'}}"></view>
            </view>

            <view class="sync-device-row__info">
              <view class="sync-device-row__name-line">
                <text class="sync-device-row__name">{{item.deviceName}}</text>
                <text wx:if="{{item.isCurrent}}" class="sync-self-tag">本机</text>
              </view>
              <text class="sync-device-row__meta">{{item.platformLabel}} · {{item.lastSeenLabel}}</text>
            </view>

            <view
              wx:if="{{item.isCurrent}}"
              class="sync-qr-pill"
              hover-class="sync-btn--hover"
              bindtap="onGenerateCode"
            >
              <text class="sync-qr-pill__text">查看二维码</text>
            </view>

            <view
              wx:if="{{item.isCurrent}}"
              class="sync-more-btn"
              hover-class="sync-btn--hover"
              bindtap="onOpenSelfMenu"
            >
              <text class="sync-more-btn__dots">⋮</text>
            </view>
            <view
              wx:else
              class="sync-more-btn"
              hover-class="sync-btn--hover"
              data-id="{{item.deviceId}}"
              data-name="{{item.deviceName}}"
              bindtap="onRemoveDevice"
            >
              <text class="sync-more-btn__dots">⋮</text>
            </view>
          </view>
        </scroll-view>

        <!-- 本机内联重命名条 -->
        <view wx:if="{{renaming}}" class="sync-rename-row">
          <input
            class="sync-rename-input"
            type="text"
            maxlength="32"
            focus="{{renaming}}"
            value="{{renameInput}}"
            placeholder="输入本机名称"
            bindinput="onRenameInput"
            bindconfirm="onConfirmRename"
          />
          <view class="sync-chip-btn" bindtap="onCancelRename">
            <text class="sync-chip-btn__text">取消</text>
          </view>
          <view class="sync-chip-btn sync-chip-btn--accent" bindtap="onConfirmRename">
            <text class="sync-chip-btn__text">保存</text>
          </view>
        </view>
      </view>

      <view class="sync-btn sync-btn--primary" hover-class="sync-btn--hover" bindtap="onScanQr">
        <view class="sync-ico sync-ico--scan sync-ico--accent-fg sync-btn__ico"></view>
        <text class="sync-btn__text">扫码关联新设备</text>
      </view>

      <view class="sync-subtle-link" hover-class="sync-btn--hover" bindtap="onShowCodeInput">
        <text class="sync-subtle-link__text">或手动输入 8 位配对码</text>
      </view>
    </view>
  </view>
</view>
