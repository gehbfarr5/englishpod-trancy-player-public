/* ============================================================================
 * 本机 -> 云端 -> 其他设备 连续两段循环光束 Hero
 * ============================================================================ */
.sync-beam-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 14px 12px;
  border-radius: var(--ep-radius-card);
  border: 1px solid var(--ep-border);
  background-color: var(--ep-surface-inset);
  background-image: radial-gradient(
    75% 85% at 50% 42%,
    var(--ep-accent-soft) 0%,
    transparent 100%
  );
}

.sync-beam__row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.sync-beam__node {
  width: 72px;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 2px;
}

.sync-beam__icon {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.sync-beam__icon--active {
  border-width: 1.4px;
  border-color: var(--ep-accent);
}

.sync-beam__icon--dashed {
  border-style: dashed;
  border-color: var(--ep-metro-outline);
  opacity: 0.85;
}

.sync-beam__node-label {
  margin-top: 5px;
  max-width: 72px;
  font-size: 11px;
  font-weight: 600;
  color: var(--ep-text-passed);
  text-align: center;
  white-space: nowrap;
}

.sync-beam__node-label.is-active {
  color: var(--ep-text-primary);
}

.sync-beam__rail-wrap {
  flex: 1;
  height: 48px;
  display: flex;
  align-items: center;
  padding: 0 4px;
}

.sync-beam__rail {
  position: relative;
  width: 100%;
  height: 2px;
  border-radius: 2px;
  background-color: var(--ep-border);
  overflow: hidden;
}

.sync-beam__rail.is-lit {
  background-color: var(--ep-accent);
  opacity: 0.45;
}

.sync-beam__rail.is-dashed {
  height: 0;
  background: transparent;
  border-top: 1.5px dashed var(--ep-metro-outline);
}

.sync-beam__comet {
  position: absolute;
  top: -1px;
  width: 38%;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent 0%, var(--ep-accent) 75%, #FFFFFF 100%);
  will-change: transform, opacity;
}

.sync-beam__comet--stage1 {
  animation: epBeamStage1 2.4s linear infinite;
}

.sync-beam__comet--stage2 {
  animation: epBeamStage2 2.4s linear infinite;
}

.sync-beam__hub-wrap {
  width: 72px;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sync-beam__hub-slot {
  position: relative;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-beam__ping {
  position: absolute;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1.6px solid var(--ep-accent);
  animation: epCloudPing 2.4s linear infinite;
  will-change: transform, opacity;
}

.sync-beam__hub {
  position: relative;
  z-index: 2;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: var(--ep-surface-1);
  border: 1.8px solid var(--ep-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 16px var(--ep-accent-soft);
}

.sync-beam__hub--synced {
  background-color: var(--ep-accent);
}

.sync-beam__hub--offline,
.sync-beam__hub--error {
  border-color: #D99B26;
}

@media (prefers-color-scheme: dark) {
  .sync-beam__hub--offline,
  .sync-beam__hub--error {
    border-color: #F5B73B;
  }
}

.sync-beam__status-pill {
  margin-top: 8px;
  padding: 5px 11px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-beam__status-pill--offline,
.sync-beam__status-pill--error {
  border-color: rgba(217, 155, 38, 0.45);
}

.sync-beam__status-text {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ep-accent);
}

.sync-beam__status-pill--offline .sync-beam__status-text,
.sync-beam__status-pill--error .sync-beam__status-text {
  color: #D99B26;
}

@media (prefers-color-scheme: dark) {
  .sync-beam__status-pill--offline .sync-beam__status-text,
  .sync-beam__status-pill--error .sync-beam__status-text {
    color: #F5B73B;
  }
}

@keyframes epBeamStage1 {
  0% {
    transform: translateX(-110%);
    opacity: 0;
  }
  8% {
    opacity: 1;
  }
  48% {
    transform: translateX(280%);
    opacity: 1;
  }
  52%, 100% {
    transform: translateX(280%);
    opacity: 0;
  }
}

@keyframes epBeamStage2 {
  0%, 42% {
    transform: translateX(-110%);
    opacity: 0;
  }
  48% {
    opacity: 1;
  }
  94% {
    transform: translateX(280%);
    opacity: 1;
  }
  98%, 100% {
    transform: translateX(280%);
    opacity: 0;
  }
}

@keyframes epCloudPing {
  0%, 38% {
    transform: scale(1);
    opacity: 0;
  }
  44% {
    transform: scale(1.06);
    opacity: 0.55;
  }
  88%, 100% {
    transform: scale(1.54);
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sync-beam__comet,
  .sync-beam__ping {
    animation: none !important;
  }
}

/* 提示横幅 */
.sync-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  margin-top: 10px;
  border-radius: var(--ep-radius-chip);
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-banner__text {
  flex: 1;
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--ep-text-primary);
  margin-right: 10px;
}

.sync-banner__dismiss {
  flex: none;
  font-size: 11px;
  font-weight: 700;
  color: var(--ep-accent);
}

/* 主体滚动区 */
.sync-sheet__body {
  max-height: 50vh;
  margin-top: 14px;
}

.sync-panel {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 4px;
}

/* 未配对动作卡片 */
.sync-action-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 16px;
  background-color: var(--ep-surface-1);
  border: 1.4px solid var(--ep-border);
}

.sync-action-card.is-primary {
  background-color: var(--ep-accent-soft);
  border-color: var(--ep-accent);
}

.sync-action-card__ico {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background-color: var(--ep-surface-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.sync-action-card__ico.is-primary {
  background-color: var(--ep-accent);
}

.sync-action-card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sync-action-card__title {
  font-size: 14.5px;
  font-weight: 800;
  color: var(--ep-text-primary);
}

.sync-action-card__desc {
  margin-top: 2px;
  font-size: 12px;
  line-height: 1.4;
  color: var(--ep-text-passed);
}

.sync-action-card__arrow {
  font-size: 18px;
  font-weight: 700;
  color: var(--ep-text-passed);
}

/* 返回头行 */
.sync-back-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-bottom: 2px;
}

.sync-back-btn {
  padding: 5px 12px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-back-btn__text {
  font-size: 12px;
  font-weight: 700;
  color: var(--ep-text-primary);
}

.sync-back-title {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
}

/* 按钮家族 */
.sync-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: 14px;
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.sync-btn__ico {
  width: 18px;
  height: 18px;
  margin-right: 8px;
}

.sync-btn--hover {
  transform: scale(0.975);
  opacity: 0.9;
}

.sync-btn.is-busy {
  opacity: 0.65;
}

.sync-btn--primary {
  background-color: var(--ep-accent);
  color: var(--ep-accent-fg);
}

.sync-btn--ghost {
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  color: var(--ep-text-primary);
}

.sync-btn__text {
  font-size: 13.5px;
  font-weight: 800;
}

.sync-row-actions {
  display: flex;
  flex-direction: row;
  gap: 10px;
}

.sync-row-actions__half {
  flex: 1;
}

/* 二维码与 8 位配对码视图 */
.sync-qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  border-radius: 18px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-border);
}

.sync-qr-frame {
  padding: 8px;
  border-radius: 14px;
  background-color: #FAF8F5;
  border: 1px solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
}

.sync-qr__canvas {
  display: block;
}

.sync-qr-placeholder {
  width: 148px;
  height: 148px;
  border-radius: 14px;
  background-color: var(--ep-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-qr-placeholder__text {
  font-size: 12px;
  color: var(--ep-text-passed);
}

.sync-qr-hint {
  margin-top: 12px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--ep-text-passed);
  text-align: center;
}

.sync-qr-code {
  margin-top: 4px;
  margin-bottom: 8px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 24px;
  font-weight: 900;
  letter-spacing: 3px;
  color: var(--ep-text-primary);
}

.sync-steps-box {
  width: 100%;
  box-sizing: border-box;
  margin-top: 14px;
  padding: 10px 12px;
  border-radius: 12px;
  background-color: var(--ep-surface-inset);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sync-step-line {
  font-size: 12px;
  line-height: 1.55;
  color: var(--ep-text-passed);
}

/* 加入输入视图 */
.sync-divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  margin: 2px 0;
}

.sync-divider__line {
  flex: 1;
  height: 1px;
  background-color: var(--ep-border);
}

.sync-divider__text {
  font-size: 11.5px;
  color: var(--ep-text-passed);
}

.sync-code-inline {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 8px;
}

.sync-code-input {
  flex: 1;
  height: 46px;
  padding: 0 12px;
  border-radius: 12px;
  background-color: var(--ep-surface-1);
  border: 1.4px solid var(--ep-border);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 2.2px;
  text-align: center;
  color: var(--ep-text-primary);
}

.sync-code-input__placeholder {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--ep-text-upcoming);
}

.sync-submit-btn {
  padding: 0 18px;
  height: 46px;
  border-radius: 12px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-submit-btn.is-ready {
  background-color: var(--ep-accent);
  border-color: var(--ep-accent);
}

.sync-submit-btn__text {
  font-size: 13.5px;
  font-weight: 800;
  color: var(--ep-text-primary);
}

.sync-submit-btn.is-ready .sync-submit-btn__text {
  color: var(--ep-accent-fg);
}

.sync-join-note {
  font-size: 11.5px;
  line-height: 1.5;
  color: var(--ep-text-passed);
}

/* 设备列表 */
.sync-devices {
  padding: 12px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-border);
}

.sync-devices__header {
  margin-bottom: 8px;
}

.sync-devices__title {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
}

.sync-device-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 0;
  border-top: 1px solid var(--ep-border);
}

.sync-device-item__badge {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background-color: var(--ep-surface-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex: none;
}

.sync-device-item__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sync-device-item__name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.sync-device-item__name {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-device-item__self {
  flex: none;
  padding: 1px 6px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-accent-soft);
  font-size: 9.5px;
  font-weight: 800;
  color: var(--ep-accent);
}

.sync-device-item__meta {
  margin-top: 2px;
  font-size: 11px;
  color: var(--ep-text-passed);
}

.sync-chip-btn {
  flex: none;
  padding: 5px 12px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-chip-btn--hover {
  opacity: 0.78;
}

.sync-chip-btn--accent {
  background-color: var(--ep-accent);
  border-color: var(--ep-accent);
  color: var(--ep-accent-fg);
}

.sync-chip-btn--danger {
  color: #D9534F;
}

@media (prefers-color-scheme: dark) {
  .sync-chip-btn--danger {
    color: #FF6B6B;
  }
}

.sync-chip-btn__text {
  font-size: 11.5px;
  font-weight: 700;
}

.sync-rename-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-top: 10px;
  margin-top: 6px;
  border-top: 1px solid var(--ep-border);
}

.sync-rename-input {
  flex: 1;
  height: 34px;
  padding: 0 10px;
  border-radius: 10px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-metro-outline);
  font-size: 13px;
  color: var(--ep-text-primary);
}

.sync-leave-wrap {
  display: flex;
  justify-content: center;
  padding-top: 2px;
}

.sync-leave-btn {
  padding: 8px 14px;
}

.sync-leave-btn__text {
  font-size: 12.5px;
  font-weight: 600;
  color: #D9534F;
}

@media (prefers-color-scheme: dark) {
  .sync-leave-btn__text {
    color: #FF6B6B;
  }
}
