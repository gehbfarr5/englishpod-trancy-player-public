/* 多端同步弹窗样式 —— 完全遵循 Warm Parchment / Dark Cocoon 令牌 + RareUI Folder 3D 动效 */
.sync-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(4px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 260ms cubic-bezier(0.25, 1, 0.5, 1);
}

.sync-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.sync-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding: 12px var(--ep-space-xl) calc(18px + env(safe-area-inset-bottom)) var(--ep-space-xl);
  background-color: var(--ep-surface-1);
  border-top: 1px solid var(--ep-deck-border);
  border-top-left-radius: 26px;
  border-top-right-radius: 26px;
  box-shadow: 0 -10px 36px rgba(0, 0, 0, 0.24);
  transform: translateY(100%);
  transition: transform 320ms var(--ep-ease-m3-decelerate);
}

.sync-mask.is-visible .sync-sheet {
  transform: translateY(0);
}

.sync-sheet__grabber-wrap {
  display: flex;
  justify-content: center;
  padding-bottom: 10px;
}

.sync-sheet__grabber {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--ep-border);
}

.sync-sheet__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10px;
}

.sync-sheet__title-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sync-sheet__title {
  font-size: 18px;
  font-weight: 800;
  color: var(--ep-text-primary);
  letter-spacing: -0.3px;
}

.sync-sheet__sub {
  margin-top: 2px;
  font-size: 11.5px;
  color: var(--ep-text-passed);
}

.sync-sheet__close {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.sync-sheet__close--hover {
  background-color: var(--ep-surface-2);
}

.sync-sheet__close-text {
  font-size: 13px;
  color: var(--ep-text-passed);
  font-weight: 700;
}

/* ============================================================================
 * RareUI FolderComponent 启发的三层 3D 文件夹交互舞台（纯 GPU 合成层）
 * ============================================================================ */
.sync-folder-stage {
  display: flex;
  justify-content: center;
  padding: 26px 0 8px;
  perspective: 900px;
}

.sync-folder {
  position: relative;
  width: 224px;
  height: 116px;
  transform-style: preserve-3d;
}

.sync-folder__tab {
  position: absolute;
  top: -10px;
  left: 0;
  width: 78px;
  height: 18px;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  background-color: var(--ep-surface-3);
  border: 1px solid var(--ep-deck-border);
  border-bottom: none;
}

.sync-folder__back {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  border-top-left-radius: 4px;
  background: linear-gradient(180deg, var(--ep-surface-3) 0%, var(--ep-surface-2) 100%);
  border: 1px solid var(--ep-deck-border);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
}

/* 3 张交错弹出卡片（左/中/右，delay: 0ms / 50ms / 100ms） */
.sync-folder__card {
  position: absolute;
  left: 50%;
  bottom: 22px;
  box-sizing: border-box;
  width: 96px;
  height: 80px;
  padding: 8px 10px;
  border-radius: 12px;
  background-color: var(--ep-deck-bg);
  border: 1px solid var(--ep-deck-border);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  opacity: 0;
  transform: translate3d(-50%, 10px, 0) scale(0.9);
  transition: transform 500ms var(--ep-ease-bounce), opacity 280ms ease-out;
  will-change: transform, opacity;
}

.sync-folder__card--left {
  z-index: 2;
  transition-delay: 0ms;
}

.sync-folder__card--center {
  z-index: 4;
  width: 118px;
  height: 92px;
  background: linear-gradient(160deg, var(--ep-deck-gradient-top) 0%, var(--ep-deck-bg) 100%);
  border-color: var(--ep-stage-box-border);
  transition-delay: 50ms;
}

.sync-folder__card--right {
  z-index: 3;
  transition-delay: 100ms;
}

.sync-folder.is-open .sync-folder__card--left {
  opacity: 1;
  transform: translate3d(-98%, -26px, 0) rotate(-9deg) scale(1);
}

.sync-folder.is-open .sync-folder__card--center {
  opacity: 1;
  transform: translate3d(-50%, -36px, 0) scale(1);
}

.sync-folder.is-open .sync-folder__card--right {
  opacity: 1;
  transform: translate3d(-2%, -26px, 0) rotate(9deg) scale(1);
}

.sync-folder__card-tag {
  font-size: 9.5px;
  font-weight: 700;
  color: var(--ep-text-passed);
}

.sync-folder__card-val {
  font-size: 20px;
  font-weight: 800;
  color: var(--ep-text-primary);
  line-height: 1.1;
}

.sync-folder__card-title {
  font-size: 13px;
  font-weight: 800;
  color: var(--ep-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-folder__card-meta {
  font-size: 9.5px;
  color: var(--ep-text-passed);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-folder__center-pill {
  align-self: flex-start;
  padding: 2px 7px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-folder__center-pill-text {
  font-size: 9px;
  font-weight: 700;
  color: var(--ep-accent);
}

/* 前层磨砂折盖 */
.sync-folder__flap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 6;
  height: 76px;
  box-sizing: border-box;
  padding: 10px 14px 12px;
  border-radius: 16px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.56) 0%, rgba(255, 255, 255, 0.34) 100%);
  backdrop-filter: blur(8px);
  border: 1px solid var(--ep-deck-border);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transform-origin: bottom center;
  transform: rotateX(-14deg);
  transition: transform 520ms var(--ep-ease-bounce);
  will-change: transform;
}

@media (prefers-color-scheme: dark) {
  .sync-folder__flap {
    background: linear-gradient(180deg, rgba(35, 39, 52, 0.78) 0%, rgba(22, 24, 33, 0.68) 100%);
  }
}

.sync-folder.is-open .sync-folder__flap {
  transform: rotateX(-40deg);
}

.sync-folder__flap-notch {
  align-self: center;
  width: 34px;
  height: 3.5px;
  border-radius: 2px;
  background-color: var(--ep-metro-outline);
}

.sync-folder__flap-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.sync-folder__flap-label {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.7px;
  color: var(--ep-text-primary);
}

.sync-folder__flap-hint {
  font-size: 8.5px;
  font-weight: 700;
  color: var(--ep-accent);
}

@media (prefers-reduced-motion: reduce) {
  .sync-folder__card {
    transition: opacity 160ms ease-out;
    transform: translate3d(-50%, 0, 0);
  }
  .sync-folder.is-open .sync-folder__card--left {
    transform: translate3d(-96%, -18px, 0);
  }
  .sync-folder.is-open .sync-folder__card--center {
    transform: translate3d(-50%, -22px, 0);
  }
  .sync-folder.is-open .sync-folder__card--right {
    transform: translate3d(-4%, -18px, 0);
  }
  .sync-folder__flap {
    transition: transform 160ms ease-out;
    transform: none;
  }
  .sync-folder.is-open .sync-folder__flap {
    transform: translateY(6px);
  }
}

/* 提示横幅 */
.sync-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  margin-top: 8px;
  border-radius: var(--ep-radius-chip);
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-banner__text {
  flex: 1;
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--ep-text-primary);
  margin-right: 10px;
}

.sync-banner__dismiss {
  flex: none;
  font-size: 11px;
  font-weight: 700;
  color: var(--ep-accent);
}

/* 主体滚动区 */
.sync-sheet__body {
  max-height: 46vh;
  margin-top: 10px;
}

.sync-panel {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 4px;
}

/* 按钮家族 */
.sync-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: var(--ep-radius-pill);
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.sync-btn--hover {
  transform: scale(0.975);
  opacity: 0.9;
}

.sync-btn.is-busy {
  opacity: 0.65;
}

.sync-btn--primary {
  background-color: var(--ep-accent);
  color: var(--ep-accent-fg);
  box-shadow: 0 6px 16px var(--ep-accent-soft);
}

.sync-btn--soft {
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
  color: var(--ep-accent);
}

.sync-btn--ghost {
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  color: var(--ep-text-primary);
}

.sync-btn__text {
  font-size: 14px;
  font-weight: 700;
}

.sync-row-actions {
  display: flex;
  flex-direction: row;
  gap: 10px;
}

.sync-row-actions__half {
  flex: 1;
}

/* 二维码与 8 位配对码视图 */
.sync-qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-qr-frame {
  padding: 8px;
  border-radius: 14px;
  background-color: #FAF8F5;
  border: 1px solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
}

.sync-qr__canvas {
  display: block;
}

.sync-qr-placeholder {
  width: 156px;
  height: 156px;
  border-radius: 14px;
  background-color: var(--ep-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-qr-placeholder__text {
  font-size: 12px;
  color: var(--ep-text-passed);
}

.sync-qr-code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.sync-qr-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 2px;
  color: var(--ep-text-primary);
}

.sync-qr-hint {
  margin-top: 8px;
  font-size: 11px;
  color: var(--ep-text-passed);
  text-align: center;
}

/* 手动输入配对码 */
.sync-code-card {
  display: flex;
  flex-direction: column;
  padding: 16px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-code-card__label {
  font-size: 12px;
  font-weight: 600;
  color: var(--ep-text-passed);
  margin-bottom: 10px;
}

.sync-code-input {
  height: 46px;
  padding: 0 14px;
  border-radius: 12px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-metro-outline);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 2px;
  text-align: center;
  color: var(--ep-text-primary);
}

.sync-code-input__placeholder {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0;
  color: var(--ep-text-upcoming);
}

.sync-code-card__hint {
  margin-top: 8px;
  font-size: 11px;
  color: var(--ep-text-passed);
}

/* 设备列表 */
.sync-devices {
  margin-top: 4px;
  padding: 12px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-devices__header {
  margin-bottom: 8px;
}

.sync-devices__title {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ep-text-passed);
}

.sync-device-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 0;
  border-top: 1px solid var(--ep-border);
}

.sync-device-item__badge {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background-color: var(--ep-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex: none;
}

.sync-device-item__badge-text {
  font-size: 10px;
  font-weight: 800;
  color: var(--ep-accent);
}

.sync-device-item__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sync-device-item__name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.sync-device-item__name {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-device-item__self {
  flex: none;
  padding: 1px 6px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-accent-soft);
  font-size: 9.5px;
  font-weight: 700;
  color: var(--ep-accent);
}

.sync-device-item__meta {
  margin-top: 2px;
  font-size: 11px;
  color: var(--ep-text-passed);
}

.sync-chip-btn {
  flex: none;
  padding: 5px 10px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-surface-2);
  border: 1px solid var(--ep-border);
}

.sync-chip-btn--hover {
  opacity: 0.78;
}

.sync-chip-btn--accent {
  background-color: var(--ep-accent);
  border-color: var(--ep-accent);
  color: var(--ep-accent-fg);
}

.sync-chip-btn--danger {
  color: #D9534F;
}

@media (prefers-color-scheme: dark) {
  .sync-chip-btn--danger {
    color: #FF6B6B;
  }
}

.sync-chip-btn__text {
  font-size: 11px;
  font-weight: 700;
}

.sync-rename-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-top: 10px;
  margin-top: 6px;
  border-top: 1px solid var(--ep-border);
}

.sync-rename-input {
  flex: 1;
  height: 34px;
  padding: 0 10px;
  border-radius: 10px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-metro-outline);
  font-size: 13px;
  color: var(--ep-text-primary);
}

.sync-leave-wrap {
  display: flex;
  justify-content: center;
  padding-top: 4px;
}

.sync-leave-btn {
  padding: 8px 14px;
}

.sync-leave-btn__text {
  font-size: 12.5px;
  font-weight: 600;
  color: #D9534F;
}

@media (prefers-color-scheme: dark) {
  .sync-leave-btn__text {
    color: #FF6B6B;
  }
}

.sync-sheet__footer {
  margin-top: 10px;
  text-align: center;
}

.sync-sheet__footer-text {
  font-size: 10.5px;
  color: var(--ep-text-upcoming);
}
