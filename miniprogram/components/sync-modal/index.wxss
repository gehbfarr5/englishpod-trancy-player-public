/* 多端同步弹窗样式 —— 完全遵循 Warm Parchment / Dark Cocoon 令牌 + RareUI Folder 3D 动效 */
.sync-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(4px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 260ms cubic-bezier(0.25, 1, 0.5, 1);
}

.sync-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.sync-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding: 12px var(--ep-space-xl) calc(18px + env(safe-area-inset-bottom)) var(--ep-space-xl);
  background-color: var(--ep-surface-1);
  border-top: 1px solid var(--ep-deck-border);
  border-top-left-radius: 26px;
  border-top-right-radius: 26px;
  box-shadow: 0 -10px 36px rgba(0, 0, 0, 0.24);
  transform: translateY(100%);
  transition: transform 320ms var(--ep-ease-m3-decelerate);
}

.sync-mask.is-visible .sync-sheet {
  transform: translateY(0);
}

.sync-sheet__grabber-wrap {
  display: flex;
  justify-content: center;
  padding-bottom: 10px;
}

.sync-sheet__grabber {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--ep-border);
}

.sync-sheet__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10px;
}

.sync-sheet__title-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sync-sheet__title {
  font-size: 18px;
  font-weight: 800;
  color: var(--ep-text-primary);
  letter-spacing: -0.3px;
}

.sync-sheet__sub {
  margin-top: 2px;
  font-size: 11.5px;
  color: var(--ep-text-passed);
}

.sync-sheet__close {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.sync-sheet__close--hover {
  background-color: var(--ep-surface-2);
}

.sync-sheet__close-text {
  font-size: 13px;
  color: var(--ep-text-passed);
  font-weight: 700;
}

/* ============================================================================
 * 双端光束流主视觉（Animated Beam 风格 —— 纯 GPU 动画层）
 * ============================================================================ */
.sync-beam-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 14px 12px;
  border-radius: var(--ep-radius-card);
  border: 1px solid var(--ep-border);
  background-color: var(--ep-surface-inset);
  background-image: radial-gradient(
    75% 85% at 50% 42%,
    var(--ep-accent-soft) 0%,
    transparent 100%
  );
}

.sync-beam__row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.sync-beam__node {
  width: 68px;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sync-beam__icon {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background-color: var(--ep-surface-2);
  border: 1px solid var(--ep-deck-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
}

.sync-beam__icon--active {
  border-color: var(--ep-stage-box-border);
}

.sync-beam__icon--dashed {
  border-style: dashed;
  border-color: var(--ep-metro-outline);
  opacity: 0.72;
}

.sync-beam__icon-text {
  font-size: 11px;
  font-weight: 800;
  color: var(--ep-text-primary);
}

.sync-beam__node-label {
  margin-top: 6px;
  max-width: 68px;
  font-size: 11px;
  font-weight: 600;
  color: var(--ep-text-passed);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-beam__rail-wrap {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 4px;
}

.sync-beam__rail {
  position: relative;
  width: 100%;
  height: 2px;
  border-radius: 2px;
  background-color: var(--ep-border);
  overflow: hidden;
}

.sync-beam__rail.is-lit {
  background-color: var(--ep-stage-box-border);
}

.sync-beam__rail.is-dashed {
  height: 0;
  background: transparent;
  border-top: 1.5px dashed var(--ep-metro-outline);
}

.sync-beam-stage.is-synced .sync-beam__rail.is-lit {
  background-color: var(--ep-accent);
  opacity: 0.85;
}

.sync-beam__comet {
  position: absolute;
  top: -1px;
  width: 36%;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent 0%, var(--ep-accent) 75%, #FFFFFF 100%);
  will-change: transform;
}

.sync-beam__comet--fwd {
  animation: epBeamFwd 1.1s linear infinite;
}

.sync-beam__comet--rev {
  background: linear-gradient(270deg, transparent 0%, var(--ep-accent) 75%, #FFFFFF 100%);
  animation: epBeamRev 1.1s linear infinite;
}

.sync-beam__hub-wrap {
  position: relative;
  width: 52px;
  height: 44px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-beam__ping {
  position: absolute;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid var(--ep-accent);
  animation: epBeamPing 1.15s cubic-bezier(0, 0, 0.2, 1) infinite;
  will-change: transform, opacity;
}

.sync-beam__hub {
  position: relative;
  z-index: 2;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background-color: var(--ep-surface-1);
  border: 1.8px solid var(--ep-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 18px var(--ep-accent-soft);
}

.sync-beam__hub--synced {
  background-color: var(--ep-accent);
}

.sync-beam__hub--offline,
.sync-beam__hub--error {
  border-color: #D99B26;
}

@media (prefers-color-scheme: dark) {
  .sync-beam__hub--offline,
  .sync-beam__hub--error {
    border-color: #F5B73B;
  }
}

.sync-beam__hub-check {
  font-size: 19px;
  font-weight: 800;
  color: var(--ep-accent-fg);
  animation: epBeamCheckPop 360ms var(--ep-ease-bounce) forwards;
}

.sync-beam__hub-text {
  font-size: 11px;
  font-weight: 800;
  color: var(--ep-accent);
  letter-spacing: 0.3px;
}

.sync-beam__status-pill {
  margin-top: 10px;
  padding: 4px 12px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-beam__status-pill--offline,
.sync-beam__status-pill--error {
  border-color: rgba(217, 155, 38, 0.45);
}

.sync-beam__status-text {
  font-size: 11px;
  font-weight: 700;
  color: var(--ep-accent);
}

.sync-beam__status-pill--offline .sync-beam__status-text,
.sync-beam__status-pill--error .sync-beam__status-text {
  color: #D99B26;
}

@media (prefers-color-scheme: dark) {
  .sync-beam__status-pill--offline .sync-beam__status-text,
  .sync-beam__status-pill--error .sync-beam__status-text {
    color: #F5B73B;
  }
}

@keyframes epBeamFwd {
  0% {
    transform: translateX(-110%);
  }
  100% {
    transform: translateX(300%);
  }
}

@keyframes epBeamRev {
  0% {
    transform: translateX(300%);
  }
  100% {
    transform: translateX(-110%);
  }
}

@keyframes epBeamPing {
  0% {
    transform: scale(0.88);
    opacity: 0.7;
  }
  90%, 100% {
    transform: scale(1.48);
    opacity: 0;
  }
}

@keyframes epBeamCheckPop {
  0% {
    transform: scale(0.6);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sync-beam__comet,
  .sync-beam__ping,
  .sync-beam__hub-check {
    animation: none !important;
  }
}

/* 提示横幅 */
.sync-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  margin-top: 8px;
  border-radius: var(--ep-radius-chip);
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-banner__text {
  flex: 1;
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--ep-text-primary);
  margin-right: 10px;
}

.sync-banner__dismiss {
  flex: none;
  font-size: 11px;
  font-weight: 700;
  color: var(--ep-accent);
}

/* 主体滚动区 */
.sync-sheet__body {
  max-height: 46vh;
  margin-top: 10px;
}

.sync-panel {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 4px;
}

/* 按钮家族 */
.sync-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: var(--ep-radius-pill);
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.sync-btn--hover {
  transform: scale(0.975);
  opacity: 0.9;
}

.sync-btn.is-busy {
  opacity: 0.65;
}

.sync-btn--primary {
  background-color: var(--ep-accent);
  color: var(--ep-accent-fg);
  box-shadow: 0 6px 16px var(--ep-accent-soft);
}

.sync-btn--soft {
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
  color: var(--ep-accent);
}

.sync-btn--ghost {
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  color: var(--ep-text-primary);
}

.sync-btn__text {
  font-size: 14px;
  font-weight: 700;
}

.sync-row-actions {
  display: flex;
  flex-direction: row;
  gap: 10px;
}

.sync-row-actions__half {
  flex: 1;
}

/* 二维码与 8 位配对码视图 */
.sync-qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-qr-frame {
  padding: 8px;
  border-radius: 14px;
  background-color: #FAF8F5;
  border: 1px solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
}

.sync-qr__canvas {
  display: block;
}

.sync-qr-placeholder {
  width: 156px;
  height: 156px;
  border-radius: 14px;
  background-color: var(--ep-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-qr-placeholder__text {
  font-size: 12px;
  color: var(--ep-text-passed);
}

.sync-qr-code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.sync-qr-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 2px;
  color: var(--ep-text-primary);
}

.sync-qr-hint {
  margin-top: 8px;
  font-size: 11px;
  color: var(--ep-text-passed);
  text-align: center;
}

/* 手动输入配对码 */
.sync-code-card {
  display: flex;
  flex-direction: column;
  padding: 16px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-code-card__label {
  font-size: 12px;
  font-weight: 600;
  color: var(--ep-text-passed);
  margin-bottom: 10px;
}

.sync-code-input {
  height: 46px;
  padding: 0 14px;
  border-radius: 12px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-metro-outline);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 2px;
  text-align: center;
  color: var(--ep-text-primary);
}

.sync-code-input__placeholder {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0;
  color: var(--ep-text-upcoming);
}

.sync-code-card__hint {
  margin-top: 8px;
  font-size: 11px;
  color: var(--ep-text-passed);
}

/* 设备列表 */
.sync-devices {
  margin-top: 4px;
  padding: 12px;
  border-radius: var(--ep-radius-card);
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
}

.sync-devices__header {
  margin-bottom: 8px;
}

.sync-devices__title {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ep-text-passed);
}

.sync-device-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 0;
  border-top: 1px solid var(--ep-border);
}

.sync-device-item__badge {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background-color: var(--ep-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex: none;
}

.sync-device-item__badge-text {
  font-size: 10px;
  font-weight: 800;
  color: var(--ep-accent);
}

.sync-device-item__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sync-device-item__name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.sync-device-item__name {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-device-item__self {
  flex: none;
  padding: 1px 6px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-accent-soft);
  font-size: 9.5px;
  font-weight: 700;
  color: var(--ep-accent);
}

.sync-device-item__meta {
  margin-top: 2px;
  font-size: 11px;
  color: var(--ep-text-passed);
}

.sync-chip-btn {
  flex: none;
  padding: 5px 10px;
  border-radius: var(--ep-radius-pill);
  background-color: var(--ep-surface-2);
  border: 1px solid var(--ep-border);
}

.sync-chip-btn--hover {
  opacity: 0.78;
}

.sync-chip-btn--accent {
  background-color: var(--ep-accent);
  border-color: var(--ep-accent);
  color: var(--ep-accent-fg);
}

.sync-chip-btn--danger {
  color: #D9534F;
}

@media (prefers-color-scheme: dark) {
  .sync-chip-btn--danger {
    color: #FF6B6B;
  }
}

.sync-chip-btn__text {
  font-size: 11px;
  font-weight: 700;
}

.sync-rename-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-top: 10px;
  margin-top: 6px;
  border-top: 1px solid var(--ep-border);
}

.sync-rename-input {
  flex: 1;
  height: 34px;
  padding: 0 10px;
  border-radius: 10px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-metro-outline);
  font-size: 13px;
  color: var(--ep-text-primary);
}

.sync-leave-wrap {
  display: flex;
  justify-content: center;
  padding-top: 4px;
}

.sync-leave-btn {
  padding: 8px 14px;
}

.sync-leave-btn__text {
  font-size: 12.5px;
  font-weight: 600;
  color: #D9534F;
}

@media (prefers-color-scheme: dark) {
  .sync-leave-btn__text {
    color: #FF6B6B;
  }
}

.sync-sheet__footer {
  margin-top: 10px;
  text-align: center;
}

.sync-sheet__footer-text {
  font-size: 10.5px;
  color: var(--ep-text-upcoming);
}
