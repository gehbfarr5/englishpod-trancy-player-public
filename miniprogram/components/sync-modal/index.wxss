/* 提示条 */
.sync-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8px 11px;
  margin-bottom: 10px;
  border-radius: 11px;
  background-color: var(--ep-accent-soft);
  border: 1px solid var(--ep-stage-box-border);
}

.sync-banner__text {
  flex: 1;
  font-size: 12px;
  line-height: 1.38;
  color: var(--ep-text-primary);
  margin-right: 10px;
}

.sync-banner__dismiss {
  flex: none;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ep-accent);
}

.sync-panel {
  display: flex;
  flex-direction: column;
}

/* 标题栏 */
.sync-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.sync-head__titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sync-head__title {
  font-size: 17.5px;
  font-weight: 800;
  color: var(--ep-text-primary);
  letter-spacing: -0.3px;
}

.sync-head__sub {
  margin-top: 2px;
  font-size: 12px;
  color: var(--ep-text-passed);
}

.sync-status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
}

.sync-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--ep-accent);
}

.sync-status-dot.is-warn {
  background-color: #D99B26;
}

.sync-icon-btn {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.sync-icon-btn.is-busy {
  opacity: 0.55;
}

/* 子视图头部 */
.sync-subhead {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
}

.sync-back-btn {
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-back-btn__text {
  font-size: 12px;
  font-weight: 700;
  color: var(--ep-text-primary);
}

.sync-subhead__title {
  font-size: 16.5px;
  font-weight: 800;
  color: var(--ep-text-primary);
}

/* 未配对双方向并排卡片 */
.sync-dual-grid {
  display: flex;
  flex-direction: row;
  gap: 10px;
}

.sync-dir-tile {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 16px 10px 14px;
  border-radius: 16px;
  background-color: var(--ep-surface-1);
  border: 1.2px solid var(--ep-border);
}

.sync-dir-tile.is-primary {
  background-color: var(--ep-accent-soft);
  border-color: var(--ep-accent);
}

.sync-dir-tile__ico {
  width: 44px;
  height: 44px;
  border-radius: 13px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 9px;
}

.sync-dir-tile__ico.is-primary {
  background-color: var(--ep-accent);
  border-color: transparent;
}

.sync-dir-tile__title {
  font-size: 14px;
  font-weight: 800;
  color: var(--ep-text-primary);
}

.sync-dir-tile__desc {
  margin-top: 3px;
  font-size: 11.5px;
  color: var(--ep-text-passed);
}

.sync-manual-row {
  margin-top: 10px;
  height: 40px;
  padding: 0 13px;
  border-radius: 12px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.sync-manual-row__text {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ep-text-primary);
}

.sync-manual-row__arrow {
  font-size: 16px;
  font-weight: 700;
  color: var(--ep-text-passed);
}

/* 展码卡片 */
.sync-qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 14px 14px;
  border-radius: 18px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-border);
}

.sync-qr-frame {
  padding: 8px;
  border-radius: 14px;
  background-color: #FAF8F5;
  border: 1px solid rgba(20, 20, 19, 0.1);
}

.sync-qr__canvas {
  display: block;
}

.sync-qr-placeholder {
  width: 148px;
  height: 148px;
  border-radius: 14px;
  background-color: var(--ep-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-qr-placeholder__text {
  font-size: 12px;
  color: var(--ep-text-passed);
}

.sync-code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
}

.sync-qr-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 2.4px;
  color: var(--ep-text-primary);
}

.sync-copy-chip {
  height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-copy-chip__text {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ep-accent);
}

.sync-qr-countdown {
  margin-top: 6px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--ep-text-passed);
}

.sync-qr-countdown.is-warn {
  color: #D99B26;
}

.sync-qr-regen {
  width: 100%;
  margin-top: 12px;
}

/* 8 格分段输码视图 */
.sync-code-hint {
  font-size: 12px;
  color: var(--ep-text-passed);
  text-align: center;
}

.sync-code-boxes {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 5px;
  margin: 12px 0 14px;
}

.sync-code-cell {
  width: 34px;
  height: 44px;
  border-radius: 10px;
  background-color: var(--ep-surface-1);
  border: 1.3px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-code-cell.is-filled {
  border-color: var(--ep-accent);
}

.sync-code-cell.is-active {
  background-color: var(--ep-accent-soft);
  border-color: var(--ep-accent);
}

.sync-code-cell__char {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18px;
  font-weight: 800;
  color: var(--ep-text-primary);
}

.sync-code-dash {
  font-size: 15px;
  font-weight: 800;
  color: var(--ep-text-passed);
  padding: 0 2px;
}

.sync-code-hidden-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}

/* 已连接设备卡片 */
.sync-section-label {
  font-size: 12px;
  font-weight: 700;
  color: var(--ep-text-passed);
  margin: 0 0 7px 2px;
}

.sync-devices-card {
  border-radius: 16px;
  background-color: var(--ep-surface-1);
  border: 1px solid var(--ep-border);
  overflow: hidden;
  margin-bottom: 12px;
}

.sync-devices-scroll {
  max-height: 204px;
}

.sync-device-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10px 12px;
  border-bottom: 1px solid var(--ep-border);
}

.sync-device-row:last-child {
  border-bottom: none;
}

.sync-device-row__ico {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex: none;
}

.sync-device-row__ico.is-self {
  border-color: var(--ep-accent);
}

.sync-device-row__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sync-device-row__name-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5px;
}

.sync-device-row__name {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-self-tag {
  flex: none;
  padding: 1px 6px;
  border-radius: 999px;
  background-color: var(--ep-accent-soft);
  color: var(--ep-accent);
  font-size: 10px;
  font-weight: 800;
}

.sync-device-row__meta {
  margin-top: 1px;
  font-size: 11px;
  color: var(--ep-text-passed);
}

.sync-qr-pill {
  flex: none;
  height: 28px;
  padding: 0 10px;
  margin-left: 6px;
  border-radius: 999px;
  background-color: var(--ep-accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-qr-pill__text {
  font-size: 11.5px;
  font-weight: 800;
  color: var(--ep-accent-fg);
}

.sync-more-btn {
  flex: none;
  width: 28px;
  height: 28px;
  margin-left: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-more-btn__dots {
  font-size: 17px;
  font-weight: 800;
  color: var(--ep-text-passed);
}

.sync-rename-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  padding: 9px 12px;
  border-top: 1px solid var(--ep-border);
}

.sync-rename-input {
  flex: 1;
  height: 32px;
  padding: 0 10px;
  border-radius: 8px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  font-size: 12.5px;
  color: var(--ep-text-primary);
}

.sync-chip-btn {
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background-color: var(--ep-surface-inset);
  border: 1px solid var(--ep-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-chip-btn--accent {
  background-color: var(--ep-accent);
  border-color: var(--ep-accent);
}

.sync-chip-btn__text {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ep-text-primary);
}

.sync-chip-btn--accent .sync-chip-btn__text {
  color: var(--ep-accent-fg);
}

/* 主按钮与轻链接 */
.sync-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: 13px;
}

.sync-btn--primary {
  background-color: var(--ep-accent);
  color: var(--ep-accent-fg);
}

.sync-btn.is-disabled {
  opacity: 0.42;
}

.sync-btn__ico {
  width: 18px;
  height: 18px;
  margin-right: 7px;
}

.sync-btn__text {
  font-size: 13.5px;
  font-weight: 800;
}

.sync-btn--hover {
  opacity: 0.84;
}

.sync-subtle-link {
  margin-top: 6px;
  padding: 6px 0;
  display: flex;
  justify-content: center;
}

.sync-subtle-link__text {
  font-size: 12px;
  font-weight: 600;
  color: var(--ep-text-passed);
}
