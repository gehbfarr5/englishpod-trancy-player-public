/* 多端学习进度同步弹窗样式（精简一屏 Bottom Sheet · Warm Parchment / Dark Cocoon 双主题） */
.sync-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.52);
  opacity: 0;
  pointer-events: none;
  transition: opacity 200ms ease-out;
}

.sync-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.sync-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 8px 18px calc(18px + env(safe-area-inset-bottom)) 18px;
  background-color: var(--ep-deck-bg);
  border-top: 1px solid var(--ep-deck-border);
  border-top-left-radius: 24px;
  border-top-right-radius: 24px;
  transform: translate3d(0, 102%, 0);
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.sync-mask.is-visible .sync-sheet {
  transform: translate3d(0, 0, 0);
}

.sync-sheet.is-dragging {
  transition: none;
}

.sync-sheet__grabber-wrap {
  display: flex;
  justify-content: center;
  padding: 2px 0 12px;
}

.sync-sheet__grabber {
  width: 36px;
  height: 4px;
  border-radius: 999px;
  background-color: var(--ep-border);
}

/* ============================================================================
 * 矢量图标 Mask（双主题纯色）
 * ============================================================================ */
.sync-ico {
  width: 20px;
  height: 20px;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

.sync-ico--primary { background-color: var(--ep-text-primary); }
.sync-ico--muted { background-color: var(--ep-text-passed); }
.sync-ico--accent { background-color: var(--ep-accent); }
.sync-ico--accent-fg { background-color: var(--ep-accent-fg); }

