.m1-entry {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  padding: 0 30rpx 20rpx;
}

.m1-entry__button {
  margin: 0;
  border-radius: 14rpx;
  background: #e4eee7;
  color: #2c6044;
  font-size: 22rpx;
  line-height: 2.4;
}

.m1-entry__note {
  color: #758178;
  font-size: 18rpx;
  text-align: center;
}
