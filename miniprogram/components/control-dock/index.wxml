<!--
  底部控制坞
  Row1：可拖动进度条 + 时间戳
  Row2：上句（跳段） · 播放/暂停 · 下句（跳段）
  Row3：上一课 / 下一课 / 单句循环 / 整课重复 / 倍速
-->
<wxs module="prog" src="./progress.wxs" />
<view class="dock">
  <!-- Row 1：进度条（经 WXS 视图层直接绑定，零 IPC 开销） -->
  <view
    class="scrub"
    data-left="{{trackLeft}}"
    data-width="{{trackWidth}}"
    bindtouchstart="{{prog.touchstart}}"
    bindtouchmove="{{prog.touchmove}}"
    bindtouchend="{{prog.touchend}}"
    bindtouchcancel="{{prog.touchend}}"
  >
    <view class="scrub__track" id="scrubTrack">
      <view class="scrub__fill" id="scrubFill" style="width: {{scrubbing ? scrubPct : progressPct}}%;"></view>
      <view class="scrub__thumb" id="scrubThumb" style="left: {{scrubbing ? scrubPct : progressPct}}%;"></view>
    </view>
  </view>
  <view class="scrub__times">
    <text class="dock__time">{{positionLabel}}</text>
    <text class="dock__time">{{durationLabel}}</text>
  </view>

  <!-- Row 2：主控 (对齐 iOS Hero Transport Row) -->
  <view class="dock__hero">
    <view class="dock__round m3-tactile-90" hover-class="m3-press-90" hover-start-time="0" hover-stay-time="150" bindtap="onPrevSentence">
      <view class="ic-skip ic-skip--prev"></view>
    </view>

    <view
      class="dock__play m3-tactile-975 {{isLoading ? 'is-loading' : ''}}"
      hover-class="m3-press-975"
      hover-start-time="0"
      hover-stay-time="150"
      bindtap="onToggle"
    >
      <view class="dock__play-icon-box">
        <view class="dock__play-icon ic-loading {{isLoading ? 'is-in' : 'is-out'}}"></view>
        <view class="dock__play-icon ic-play {{isLoading || ended || isPlaying ? 'is-out' : 'is-in'}}"></view>
        <view class="dock__play-icon ic-pause {{isLoading || ended ? 'is-out' : (isPlaying ? 'is-in' : 'is-out')}}"></view>
        <view class="dock__play-icon ic-replay {{isLoading || !ended ? 'is-out' : 'is-in'}}"></view>
      </view>
      <text class="dock__play-label">{{isLoading ? 'Loading' : (ended ? 'Replay' : (isPlaying ? 'Pause' : 'Play'))}}</text>
    </view>

    <view class="dock__round m3-tactile-90" hover-class="m3-press-90" hover-start-time="0" hover-stay-time="150" bindtap="onNextSentence">
      <view class="ic-skip ic-skip--next"></view>
    </view>
  </view>

  <!-- Row 3：工具键 -->
  <view class="dock__util">
    <view
      class="dock__util-btn m3-tactile-94 {{hasPrevLesson ? '' : 'is-disabled'}}"
      hover-class="{{hasPrevLesson ? 'm3-press-94' : ''}}"
      hover-start-time="0"
      hover-stay-time="150"
      bindtap="onPrevLesson"
    >
      <view class="ic ic--prev-lesson"></view>
    </view>
    <view
      class="dock__util-btn m3-tactile-94 {{hasNextLesson ? '' : 'is-disabled'}}"
      hover-class="{{hasNextLesson ? 'm3-press-94' : ''}}"
      hover-start-time="0"
      hover-stay-time="150"
      bindtap="onNextLesson"
    >
      <view class="ic ic--next-lesson"></view>
    </view>
    <view
      class="dock__util-btn m3-tactile-94 {{singleSentenceLoop ? 'is-on' : ''}}"
      hover-class="m3-press-94"
      hover-start-time="0"
      hover-stay-time="150"
      bindtap="onToggleLoop"
    >
      <view class="ic ic--loop-one"></view>
    </view>
    <view
      class="dock__util-btn m3-tactile-94 {{repeatEpisode ? 'is-on' : ''}}"
      hover-class="m3-press-94"
      hover-start-time="0"
      hover-stay-time="150"
      bindtap="onToggleRepeat"
    >
      <view class="ic ic--repeat"></view>
    </view>
  </view>
</view>
