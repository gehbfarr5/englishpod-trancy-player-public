.ic--speed {
  width: var(--ep-speed-icon);
  height: var(--ep-speed-icon);
  -webkit-mask-image: url('data:image/svg+xml;base64,');
  mask-image: url('data:image/svg+xml;base64,');
}

/* 非 1.0x 倍速的文字（11 / w800 / 等宽数字） */
.dock__speed-text {
  margin-left: var(--ep-speed-gap);
  font-size: var(--ep-speed-font);
  font-weight: var(--ep-fw-heavy);
  color: var(--ep-accent);
  font-variant-numeric: tabular-nums;
}
