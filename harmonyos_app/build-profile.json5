{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.1",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    },
    {
      "name": "ep_design",
      "srcPath": "./packages/ep_design"
    },
    {
      "name": "ep_domain",
      "srcPath": "./packages/ep_domain"
    },
    {
      "name": "ep_audio",
      "srcPath": "./packages/ep_audio"
    },
    {
      "name": "ep_harmony_ext",
      "srcPath": "./packages/ep_harmony_ext"
    }
  ]
}
